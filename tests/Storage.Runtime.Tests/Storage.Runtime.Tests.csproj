<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Storage/Contracts.cs" Link="Production/Contracts.cs" />
    <Compile Include="../../Storage/Core/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../Storage/Runtime/StorageJournal.cs" Link="Production/StorageJournal.cs" />
    <Compile Include="../../Storage/Runtime/GameInventoryAdapter.cs" Link="Production/GameInventoryAdapter.cs" />
  </ItemGroup>
</Project>
