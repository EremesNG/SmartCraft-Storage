    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath></Reference>
    <Compile Include="NativeGridHarness.cs" />
    <Compile Include="../../Storage/UI/NativeTerminalLayout.cs" Link="Production/NativeTerminalLayout.cs" />
    <Compile Include="../../Hotkeys/HotkeyConfig.cs" Link="Production/HotkeyConfig.cs" />
    <Reference Include="Jotunn"><HintPath>$(NuGetPackageRoot)jotunnlib/2.30.0/lib/net462/Jotunn.dll</HintPath></Reference>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
