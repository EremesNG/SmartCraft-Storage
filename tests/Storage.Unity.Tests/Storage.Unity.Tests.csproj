    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManagedDir)/assembly_valheim.dll</HintPath><Publicize>true</Publicize></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimManagedDir)/assembly_utils.dll</HintPath><Publicize>true</Publicize></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimManagedDir)/assembly_guiutils.dll</HintPath><Publicize>true</Publicize></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManagedDir)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManagedDir)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ValheimManagedDir)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ValheimManagedDir)/UnityEngine.UIModule.dll</HintPath></Reference>
