<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" Condition="Exists('Program.cs')" />
    <Compile Include="StationScenarios.cs" Condition="Exists('StationScenarios.cs')" />
    <Compile Include="NativeUiScenarios.cs" Condition="Exists('NativeUiScenarios.cs')" />
    <Compile Include="../../Storage/Contracts.cs" Link="Production/Contracts.cs" />
    <Compile Include="../../Storage/Core/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../Storage/Integration/StationOperationController.cs" Link="Production/StationOperationController.cs" Condition="Exists('../../Storage/Integration/StationOperationController.cs')" />
    <Compile Include="../../Storage/UI/DepositSelection.cs" Link="Production/DepositSelection.cs" Condition="Exists('../../Storage/UI/DepositSelection.cs')" />
    <Compile Include="../../Storage/UI/TerminalInteractionModel.cs" Link="Production/TerminalInteractionModel.cs" Condition="Exists('../../Storage/UI/TerminalInteractionModel.cs')" />
  </ItemGroup>
</Project>
